<!-- Tabletop pick-and-place scene. World frame == table frame: origin at marker 0 (near-left corner of the
     50 x 35 cm workspace), +x to the right along the near edge, +y away from the robot, z = 0 on the table top.
     The Panda base is mounted at (0.25, -0.30, 0) facing +y (see franka_emika_panda/panda.xml). -->
<mujoco model="pickplace scene">
  <include file="franka_emika_panda/panda.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.25 0.25 0.25" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <global offwidth="960" offheight="960"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.8 0.85" rgb2="0.35 0.4 0.45" width="256" height="1536"/>
    <texture name="wood" type="2d" builtin="flat" rgb1="0.66 0.56 0.44" width="64" height="64"/>
    <material name="table" texture="wood" rgba="1 1 1 1"/>
    <material name="m_red" rgba="0.85 0.12 0.12 1"/>
    <material name="m_green" rgba="0.12 0.7 0.2 1"/>
    <material name="m_blue" rgba="0.12 0.25 0.85 1"/>
    <material name="m_yellow" rgba="0.95 0.85 0.1 1"/>
    <material name="m_purple" rgba="0.45 0.12 0.6 1"/>
    <material name="m_orange" rgba="0.95 0.38 0.0 1"/>
    <material name="marker" rgba="0.05 0.05 0.05 1"/>
  </asset>

  <default>
    <default class="cube">
      <geom type="box" size="0.02 0.02 0.02" mass="0.05" friction="1.5 0.02 0.001" condim="4"
            solref="0.004 1"/>
    </default>
    <default class="zone">
      <geom type="box" size="0.05 0.05 0.0005" contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.25 0.2 1.8" dir="0 0 -1" directional="true" castshadow="true" diffuse="0.45 0.45 0.45"/>
    <body name="table" pos="0.25 0.1 -0.025">
      <geom name="table" type="box" size="0.6 0.5 0.025" material="table" friction="1 0.005 0.0001"/>
    </body>

    <!-- workspace corner markers (visual only) -->
    <geom type="box" size="0.015 0.015 0.0003" pos="0 0 0.0003" material="marker" contype="0" conaffinity="0"/>
    <geom type="box" size="0.015 0.015 0.0003" pos="0.5 0 0.0003" material="marker" contype="0" conaffinity="0"/>
    <geom type="box" size="0.015 0.015 0.0003" pos="0.5 0.35 0.0003" material="marker" contype="0" conaffinity="0"/>
    <geom type="box" size="0.015 0.015 0.0003" pos="0 0.35 0.0003" material="marker" contype="0" conaffinity="0"/>

    <!-- target zones: mocap bodies, so reset() can move them -->
    <body name="zone_yellow" mocap="true" pos="0.1 0.25 0.0005"><geom class="zone" material="m_yellow"/></body>
    <body name="zone_purple" mocap="true" pos="0.25 0.25 0.0005"><geom class="zone" material="m_purple"/></body>
    <body name="zone_orange" mocap="true" pos="0.4 0.25 0.0005"><geom class="zone" material="m_orange"/></body>

    <body name="cube_red" pos="0.1 0.1 0.02"><freejoint name="cube_red"/><geom class="cube" material="m_red"/></body>
    <body name="cube_green" pos="0.25 0.1 0.02"><freejoint name="cube_green"/><geom class="cube" material="m_green"/></body>
    <body name="cube_blue" pos="0.4 0.1 0.02"><freejoint name="cube_blue"/><geom class="cube" material="m_blue"/></body>

    <body name="cam_target" pos="0.25 0.15 0.05"/>
    <camera name="top" pos="0.25 0.175 1.2" xyaxes="1 0 0 0 1 0" fovy="45"/>
    <!-- "phone": SmolVLA image observation. Like a phone looking down at the table from 0.95 m, tilted 22 deg and
         placed beyond the far edge: a straight-down camera is mostly blocked by the arm during reach/carry
         (NOTES.md). Its image is rotated 180 deg compared with the human phone clips (far edge at the bottom). -->
    <camera name="phone" pos="0.25 0.55 0.95" xyaxes="-1 0 0 0 -0.9251 0.3798" fovy="40"/>
    <!-- "phone_match": pose set at runtime from the real phone's ArUco-estimated pose (human/camera_match.py) -->
    <camera name="phone_match" pos="0.25 0.175 0.45" xyaxes="1 0 0 0 1 0" fovy="90"/>
    <camera name="front" pos="0.25 1.05 0.65" mode="targetbody" target="cam_target" fovy="45"/>
  </worldbody>

  <contact>
    <exclude body1="table" body2="link0"/>
    <exclude body1="table" body2="link1"/>
  </contact>
</mujoco>
